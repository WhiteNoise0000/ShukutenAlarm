<?xml version="1.0" encoding="utf-8"?>
<!--
  次回アラーム表示ウィジェット（2x1 のコンパクト表示）
  - スキップボタンと日付表示を常に含むレイアウト
  - 拡張版と共通のID構成で、Provider側で制御
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

  <!-- 右: スキップボタン -->
  <TextView
      android:id="@+id/button_skip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:background="@drawable/bg_widget_button"
      android:paddingStart="6dp"
      android:paddingTop="4dp"
      android:paddingEnd="6dp"
      android:paddingBottom="4dp"
      android:text="@string/widget_skip"
      android:textAllCaps="false"
      android:textColor="@android:color/white"
      android:textSize="11sp"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:visibility="gone" />

  <!-- 左: 情報ブロック（タイトル/時刻/日付） -->
  <LinearLayout
      android:id="@+id/info_block"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_toStartOf="@id/button_skip"
      android:layout_marginEnd="6dp"
      android:layout_centerVertical="true"
      android:orientation="vertical">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_next_alarm_title"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/text_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="--:--"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/text_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

  </LinearLayout>

  <!-- 拡張表示でのみ利用するため、コンパクト表示では非表示のまま保持。 -->
  <TextView
      android:id="@+id/text_alarm_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_above="@id/button_skip"
      android:layout_alignEnd="@id/button_skip"
      android:layout_marginBottom="2dp"
      android:textColor="#B3FFFFFF"
      android:textSize="9sp"
      android:maxLines="1"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:visibility="gone" />

</RelativeLayout>
